rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Course content: everyone can read, only admins (console/scripts) write.
    match /courses/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Player profiles: public read (leaderboard), owner-only write with a
    // schema check so nobody can inflate arbitrary fields. Anonymous
    // (guest) accounts don't compete, so they may not write profiles.
    match /users/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        // Keep this list in step with AuthController._mirrorProfile in
        // lib/state/providers.dart — hasOnly rejects the whole write if the
        // app sends a single key that isn't listed here, and the client
        // swallows the error, so drift shows up as a silently frozen
        // leaderboard rather than a visible failure.
        && request.resource.data.keys().hasOnly(
             ['name', 'tag', 'provider', 'photoUrl', 'xp', 'xpWeek',
              'weekKey', 'streakDays', 'levelsCompleted', 'badges',
              'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xpWeek is int
        && request.resource.data.xpWeek >= 0;
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Per-user attempt history (future sync).
      match /attempts/{attemptId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
